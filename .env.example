# Copy to .env for local backend development. Configure real values in the deployment host.
PORT=3001
NODE_ENV=development
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
ADMIN_EMAIL=admin@example.edu
ADMIN_PASSWORD=replace-with-a-unique-strong-password
CORS_ALLOWED_ORIGINS=http://localhost:4173
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
EXPO_PUBLIC_API_URL=https://ai-attendance-backend-peh3.onrender.com/api

